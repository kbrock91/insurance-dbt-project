# dbt MCP Configuration
# Copy this file to .env and fill in your values
# Usage: cp .env.example .env

# dbt Cloud host URL (default: https://cloud.getdbt.com)
DBT_HOST_URL=https://cloud.getdbt.com

# dbt Cloud service token or personal access token
# Required permissions: Semantic Layer, Developer
DBT_TOKEN=your-service-token-here

# Production environment ID from dbt Cloud
# Find this in dbt Cloud > Deploy > Environments > your environment
DBT_ENVIRONMENT_ID=123456
